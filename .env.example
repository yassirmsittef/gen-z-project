# PostgreSQL. En PROD (Neon/Supabase) : DATABASE_URL = connexion POOLÉE, DIRECT_URL = DIRECTE.
# En local (npm run db:start), les deux pointent sur la même base.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tremplin?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/tremplin?schema=public"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Google OAuth (optionnel — le bouton Google n'apparaît que si renseigné)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (recharges en argent réel, 1 token = 1 $ — laisser vide = mode démo fictif)
# Clés de TEST : dashboard.stripe.com → Développeurs → Clés API (sk_test_...)
STRIPE_SECRET_KEY=""
# Webhook local : stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Vercel (expiration des campagnes) — openssl rand -hex 16. Vercel l'envoie en Bearer.
CRON_SECRET=""

# --- IA (copilote partenariats) ---
# Clé API Anthropic (https://platform.claude.com) : active l'analyse approfondie
# des demandes de partenariat. Sans clé, l'analyse heuristique locale s'applique.
ANTHROPIC_API_KEY=""

# Emails transactionnels (mot de passe oublié) — Resend (https://resend.com).
# Sans domaine vérifié chez Resend, l'envoi n'est possible QUE vers l'adresse
# du compte Resend lui-même. EMAIL_FROM par défaut : onboarding@resend.dev.
RESEND_API_KEY=""
# EMAIL_FROM="Tremplin <no-reply@ton-domaine.fr>"
