generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/serverless : url = connexion POOLÉE (runtime), directUrl = DIRECTE (migrations).
  // En local, les deux pointent sur la même base.
  directUrl = env("DIRECT_URL")
}

// ---------- Utilisateurs & Auth.js ----------

enum Role {
  MEMBER
  ADMIN // modération : file des signalements, suppression de commentaires
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  role             Role      @default(MEMBER)
  /// Octets occupés par la photo de profil sur le stockage, mesurés à l'envoi.
  /// Les photos vivent dans le MÊME magasin que les témoignages : sans ce
  /// champ, la jauge ne voyait qu'un des deux producteurs et le plafond
  /// laissait le magasin déborder par l'autre bout.
  avatarBytes      Int?
  name             String?
  avatarUrl        String?
  bio              String? // courte présentation affichée sur le profil public
  emailVerified    DateTime?
  passwordHash     String?
  // Cumul à vie des contributions converties en cents US au moment du
  // paiement (non décrémenté par les remboursements) — alimente le gate
  // « 50 $ contribués avant de poster » et les classements inter-devises.
  contributedUsdCents Int    @default(0)
  // Devise d'AFFICHAGE choisie par le membre : les montants de son dashboard
  // sont convertis dedans (taux du jour, indicatif). Les paiements et le gate
  // 50 $ ne changent pas — c'est une préférence de lecture, pas de compte.
  preferredCurrency   String @default("eur")
  // Langue de l'interface, choisie dès l'inscription (7 codes, src/lib/i18n).
  // Comme la devise : une préférence de lecture, relue en base par requête —
  // jamais embarquée dans le JWT. Les emails partent dans cette langue.
  preferredLanguage   String @default("fr")
  // Liens publics du profil (site, réseaux…) — 3 max, https uniquement.
  links               String[] @default([])
  reputation       Int       @default(0)
  skills           String[]  @default([])
  // Localisation déclarative pour le globe Communauté : ville choisie dans la
  // liste de src/lib/cities.ts, coordonnées de la VILLE (jamais de position précise).
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  // Compte Stripe Connect Express du porteur (Phase 2 : versements réels).
  stripeAccountId  String?
  // Types de notifications que l'utilisateur a coupés (préférences).
  mutedNotifications NotificationType[] @default([])
  createdAt        DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  contributions    Contribution[]
  reputationEvents ReputationEvent[]
  reports          Report[]
  resetTokens      PasswordResetToken[]
  votes            Vote[]
  messagesSent     Message[]           @relation("MessagesSent")
  messagesReceived Message[]           @relation("MessagesReceived")
  groupsOwned      ChatGroup[]         @relation("GroupsOwned")
  groupMemberships ChatGroupMember[]
  groupMessages    GroupMessage[]      @relation("GroupMessagesSent")
  groupBans        ChatGroupBan[]      @relation("GroupBans")
  groupBansIssued  ChatGroupBan[]      @relation("GroupBansIssued")
  notifications    Notification[]
  comments         Comment[]
  follows          Follow[]
  boycottCalls     BoycottCall[]
  boycottSupports  BoycottSupport[]
  callComments     CallComment[]
  callVideos       CallVideo[]
  uploadTickets    UploadTicket[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Projets ----------

enum ProjectStatus {
  ACTIVE // en campagne, collecte en cours
  FUNDED // objectif atteint, fonds sous séquestre, déblocage par étapes
  COMPLETED // toutes les étapes validées
  FAILED // objectif non atteint ou preuves refusées → remboursement
}

enum ProjectCategory {
  TECH
  ECOMMERCE
  SERVICES
  CREATIF
  MUSIQUE
  MODE
  GAMING
  FOOD
  EDUCATION
  SANTE
  FINANCE
  IMPACT
  SPORT
  MEDIA
  ARTISANAT
  IMMOBILIER
  AUTRE
}

model Project {
  id            String          @id @default(cuid())
  ownerId       String
  title         String
  slug          String          @unique
  pitch         String
  description   String
  category      ProjectCategory
  // Devise du projet (code ISO minuscule accepté par Stripe : eur, usd, mad…).
  // TOUS les montants du projet (goal, raised, released, étapes, votes) sont
  // en unités MINEURES de cette devise.
  currency      String          @default("usd")
  goal          Int
  raised        Int             @default(0)
  released      Int             @default(0) // déjà débloqué vers le porteur (unités mineures)
  coverUrl      String?
  deadline      DateTime
  // Échéance de réalisation : REALIZATION_DAYS après le financement pour
  // livrer toutes les étapes. Au-delà, un vote ouvert est tranché à la
  // balance courante puis le séquestre restant est remboursé (décision
  // 2026-07-11 : 90 j, au plafond de rétention Stripe).
  realizationDeadline DateTime?
  status        ProjectStatus   @default(ACTIVE)
  failureReason String?
  neededSkills  String[]        @default([])
  createdAt     DateTime        @default(now())

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  milestones          Milestone[]
  contributions       Contribution[]
  partnershipRequests PartnershipRequest[]
  updates             ProjectUpdate[]
  comments            Comment[]
  follows             Follow[]
  boycottAnswers      BoycottAnswer[]

  @@index([status, category])
}

// ---------- Partenariats de marques ----------

enum PartnershipStatus {
  PENDING // en attente de réponse du porteur
  ACCEPTED
  DECLINED
}

enum PartnershipCompensation {
  MONEY // rémunération en argent
  PRODUCT // produits / dotation
  VISIBILITY // « exposition » seule — signal de prudence classique
  MIXED // argent + produits
}

/// Demande de partenariat déposée par une marque (formulaire public, sans compte).
/// La marque suit la réponse via un lien privé (trackToken) ; le porteur répond
/// depuis sa boîte /partenariats avec l'aide de l'analyse IA (aiAnalysis).
model PartnershipRequest {
  id           String                  @id @default(cuid())
  projectId    String
  brandName    String
  contactName  String?
  brandEmail   String
  brandWebsite String?
  compensation PartnershipCompensation
  budget       Int? // en $ (si MONEY ou MIXED)
  message      String // l'offre détaillée
  deliverables String? // ce que la marque attend en retour
  status       PartnershipStatus       @default(PENDING)
  trackToken   String                  @unique @default(cuid())
  aiAnalysis   Json? // analyse fiabilité/équité (cache)
  aiAnalyzedAt DateTime?
  ownerReply   String? // réponse envoyée à la marque
  respondedAt  DateTime?
  createdAt    DateTime                @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ---------- Étapes & preuves ----------

enum MilestoneStatus {
  LOCKED // en attente des étapes précédentes
  AWAITING_PROOF // le porteur doit soumettre une preuve
  UNDER_REVIEW // preuve soumise, vote pondéré des contributeurs en cours
  RELEASED // preuve validée, fonds débloqués
}

model Milestone {
  id               String          @id @default(cuid())
  projectId        String
  order            Int
  title            String
  description      String
  amount           Int // montant débloqué par cette étape, unités mineures (somme = objectif)
  status           MilestoneStatus @default(LOCKED)
  rejectionCount   Int             @default(0)

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proofs  Proof[]
  payouts MilestonePayout[]

  @@unique([projectId, order])
}

/// Part du versement d'une étape débloquée, adossée à la charge Stripe d'une
/// contribution (transfer `source_transaction` : aucun solde plateforme requis,
/// la devise du projet est gardée de bout en bout). La répartition entre
/// contributions est proportionnelle pour que chaque charge conserve de quoi
/// rembourser son prorata si le projet échoue ensuite. Les montants sont figés
/// en transaction à la libération ; stripeTransferId absent = à rejouer
/// (exécution après commit + cron quotidien, comme les remboursements).
model MilestonePayout {
  id               String   @id @default(cuid())
  milestoneId      String
  contributionId   String
  // Montant en unités mineures de la devise du projet.
  amountMinor      Int
  stripeTransferId String?
  createdAt        DateTime @default(now())

  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, contributionId])
  @@index([contributionId])
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model Proof {
  id          String      @id @default(cuid())
  milestoneId String
  content     String
  links       String[]    @default([])
  imageUrls   String[]    @default([])
  status      ProofStatus @default(PENDING)
  submittedAt DateTime    @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  votes     Vote[]
}

enum VoteDecision {
  APPROVE
  REJECT
}

model Vote {
  id        String       @id @default(cuid())
  proofId   String
  userId    String
  weight    Int // poids = total contribué par le votant à ce projet, figé au moment du vote
  decision  VoteDecision
  createdAt DateTime     @default(now())

  proof Proof @relation(fields: [proofId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proofId, userId])
}

// ---------- Contributions & crédits ----------

model Contribution {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  // Montant en unités MINEURES de la devise du projet (cents, centimes…).
  amount    Int
  // Équivalent en cents US au taux du jour du paiement (gate + classements).
  usdCents  Int      @default(0)
  // Références Stripe : la session (idempotence du webhook), le
  // payment_intent (remboursements réels) et la charge (versements adossés
  // par source_transaction — résolue depuis le PI puis cachée ici).
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  stripeChargeId        String?
  // Contribution anonyme (choix au paiement) : l'identité n'apparaît sur
  // AUCUNE surface publique ni chez le porteur — anonymat d'affichage
  // seulement, le poids de vote et le remboursement restent inchangés.
  anonymous Boolean @default(false)
  // Remboursement : montant dû (prorata, unités mineures) posé à l'échec,
  // exécuté chez Stripe après commit — stripeRefundId absent = à rejouer.
  refunded        Boolean @default(false)
  refundDueMinor  Int     @default(0)
  stripeRefundId  String?
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payouts MilestonePayout[]

  @@index([projectId])
  @@index([userId])
}

// ---------- Vie du projet : suivi, actus du porteur & discussion ----------

/// Suivre un projet sans (encore) contribuer : les followers reçoivent les
/// actus du porteur et l'annonce du financement, comme les contributeurs.
model Follow {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}


/// Actualité postée par le porteur — le fil de nouvelles du projet.
model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  title     String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Commentaire public sous un projet. Modération légère : l'auteur ou le
/// porteur du projet peuvent supprimer.
model Comment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------- Réinitialisation de mot de passe ----------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 du token — le token en clair ne vit que dans l'email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Échecs de connexion récents — anti brute-force du login (src/lib/login-rate-limit.ts).
// Une ligne par tentative ratée, comptées sur une fenêtre glissante ; vidées au
// succès, purgées par le cron. Email en clé (minuscules) : couvre aussi les
// adresses sans compte, sans révéler leur existence.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ---------- Signalements (modération) ----------

enum ReportTargetType {
  PROJECT
  COMMENT
  USER
  CHAT_GROUP // groupe de chat (nom, intention ou ambiance du salon)
  GROUP_MESSAGE // un message précis dans un salon
  BOYCOTT_CALL // un appel publié dans le fil des remplacements
  CALL_COMMENT // un commentaire sous un appel
  CALL_VIDEO // un témoignage vidéo rattaché à un appel
}

enum ReportStatus {
  OPEN
  RESOLVED // traité (action prise ou jugé fondé)
  DISMISSED // rejeté (non fondé)
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String // id de l'objet visé (projet, commentaire, membre)
  reason     String // motif choisi dans REPORT_REASONS
  detail     String? // précision libre du signaleur
  status     ReportStatus     @default(OPEN)
  handledAt  DateTime?
  handledBy  String? // id de l'admin qui a tranché
  createdAt  DateTime         @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // « Un seul signalement OUVERT par personne et par cible » est garanti par
  // le service (une contrainte unique incluant status casserait au 2e
  // signalement résolu sur la même cible).
  @@index([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// ---------- Messagerie (entraide entre porteurs) ----------

model Message {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  createdAt   DateTime @default(now())

  sender    User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

// ---------- Groupes de chat (une catégorie = des salons) ----------
// Le privé (Message) sert au un-à-un ; les groupes sont les places publiques
// de la plateforme, rangées dans les MÊMES catégories que les projets —
// « Gaming », « Musique »… Créés par n'importe quel membre, ouverts à tous.

model ChatGroup {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  purpose   String // à quoi sert ce groupe, une phrase
  category  ProjectCategory
  ownerId   String
  // Salon d'accueil ouvert par la plateforme (les salons de langue) : épinglé
  // en tête de l'annuaire et hors plafond de groupes animés.
  official  Boolean         @default(false)
  createdAt DateTime        @default(now())

  owner    User              @relation("GroupsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ChatGroupMember[]
  messages GroupMessage[]
  bans     ChatGroupBan[]

  @@index([category, createdAt])
  @@index([official, createdAt])
  @@index([ownerId])
}

model ChatGroupMember {
  groupId String
  userId  String
  // Gérant·e : partage la modération avec l'animateur (exclure un membre),
  // sans pouvoir nommer d'autres gérant·es ni toucher à l'animation.
  manager Boolean @default(false)
  // Salon mis en silence : plus de notification pour CE salon (les autres
  // continuent). La pastille de non-lus, elle, reste — se taire n'est pas
  // se cacher ce qui s'y dit.
  muted   Boolean @default(false)
  // Dernier passage dans le fil : alimente la pastille « non lus ».
  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, joinedAt])
  @@index([groupId, manager])
}

/// Exclusion d'un salon : la personne en sort et ne peut plus y revenir tant
/// que l'animation ne la réadmet pas. Ses messages restent — retirer un
/// propos est un geste distinct de retirer une personne.
model ChatGroupBan {
  groupId   String
  userId    String
  byId      String // qui a prononcé l'exclusion (traçabilité)
  createdAt DateTime @default(now())

  group ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation("GroupBans", fields: [userId], references: [id], onDelete: Cascade)
  by    User      @relation("GroupBansIssued", fields: [byId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id       String @id @default(cuid())
  groupId  String
  senderId String
  body     String
  // Ligne d'événement écrite par la plateforme (arrivée d'un membre) plutôt
  // que par une personne : rendue en filet centré, jamais en bulle, et
  // ignorée des aperçus, des compteurs et des non-lus.
  system    Boolean  @default(false)
  createdAt DateTime @default(now())

  group  ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation("GroupMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([senderId, createdAt])
}

// ---------- Notifications ----------

enum NotificationType {
  CONTRIBUTION // quelqu'un a soutenu ton projet
  CONTRIBUTION_CONFIRMED // ton paiement est enregistré, fonds au séquestre
  PROJECT_FUNDED // objectif atteint
  PROJECT_FAILED // campagne non aboutie
  REFUND // contribution remboursée
  PROOF_TO_VOTE // une preuve attend ton vote
  MILESTONE_RELEASED // étape validée, fonds débloqués
  PROOF_REJECTED // preuve refusée par la communauté
  MESSAGE // nouveau message privé
  GROUP_MESSAGE // nouveau message dans un groupe rejoint
  PARTNERSHIP // nouvelle demande de partenariat
  COMMENT // nouveau commentaire sur ton projet
  PROJECT_UPDATE // le porteur a posté une actu
  BOYCOTT_ANSWERED // un projet se lance pour remplacer une marque que tu veux voir remplacée
  BOYCOTT_REMOVED // ton appel a été retiré par la modération (type distinct : ne doit pas être masquable avec le reste)
  CALL_COMMENT // quelqu'un a commenté ton appel
  CALL_VIDEO // quelqu'un a posté un témoignage vidéo sous ton appel
  STORAGE_ALERT // réservé aux admins : le stockage vidéo approche ou atteint son plafond
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  /// Gabarit i18n (clé du catalogue notification-catalog.ts) : la ligne
  /// stocke la MATIÈRE (clé + params bruts), jamais de texte rendu — le
  /// rendu se fait à la LECTURE, dans la langue du lecteur. Le défaut ""
  /// n'existe que pour la fenêtre de déploiement (anciennes lambdas) : le
  /// rendu retombe alors sur le libellé du type, et la migration de
  /// contraction purgera ces lignes.
  key       String           @default("")
  params    Json?
  /// Extrait de contenu MEMBRE cité (légende, réponse, commentaire…) —
  /// colonne dédiée et non champ de `params` : le retrait du contenu la
  /// neutralise par updateMany (un Json ne se patche pas partiellement), et
  /// l'exigence des tests est que le texte retiré disparaisse DE LA BASE.
  excerpt   String?
  /// Posé quand l'extrait a été neutralisé : le rendu affiche alors la
  /// pierre tombale du type (« Ce témoignage a été retiré. »…).
  retractedAt DateTime?
  /// Fenêtre de déploiement uniquement (expand→contract) : les anciennes
  /// lambdas écrivent encore ces deux colonnes, plus aucun code neuf ne les
  /// lit. Supprimées par la migration de contraction.
  title     String?
  body      String?
  /// Le contenu qui a DÉCLENCHÉ la notification (id de commentaire, de
  /// réponse…). Sert à retrouver la ligne quand ce contenu est retiré : le
  /// corps en recopie un extrait, et sans clé on ne pouvait le neutraliser
  /// qu'en filtrant sur le TEXTE — ce qui frappait aussi les notifications
  /// d'un contenu identique mais toujours en ligne.
  sourceId  String?
  href      String // destination du clic
  readAt    DateTime?
  // Relais email des types majeurs : posé quand l'email est parti (envoi
  // post-commit, rejoué par le cron — même pattern que les mouvements Stripe).
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type, sourceId])
}

// ---------- Appels au remplacement (le fil) ----------
//
// Un membre nomme une marque dont il ne veut plus et dit pourquoi. GeniGain
// HÉBERGE ce contenu, ne l'écrit pas et ne l'endosse pas : l'auteur est
// toujours affiché, l'appel est signalable (Report.BOYCOTT_CALL) et retirable
// — par son auteur ou par la modération, qui laisse une pierre tombale plutôt
// que d'effacer l'historique.
//
// Le but n'est pas la colère mais le remplacement : un appel est une DEMANDE
// ouverte, à laquelle un projet vient répondre (BoycottAnswer).

model BoycottCall {
  id       String          @id @default(cuid())
  authorId String
  slug     String          @unique
  /** La marque visée, telle que l'auteur l'écrit (affichée). */
  target   String
  /** `target` normalisé (minuscules, sans accents) : regroupe les appels visant la même marque. */
  targetKey String
  category ProjectCategory
  /** Le motif, écrit par l'auteur. C'est SON propos, jamais celui de la plateforme. */
  reason   String
  /** Ce qu'il faudrait à la place — la commande passée aux porteurs. */
  wanted   String
  /** Liens à l'appui (https uniquement, MAX_CALL_SOURCES). */
  sources  String[]        @default([])

  // Retrait : on ne supprime pas la ligne (les soutiens et les réponses ont
  // une histoire), on la masque.
  removedAt     DateTime?
  removedById   String? // null + removedAt posé = retiré par l'auteur
  removalReason String?

  createdAt DateTime @default(now())

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  supports BoycottSupport[]
  answers  BoycottAnswer[]
  comments CallComment[]
  videos   CallVideo[]

  @@index([targetKey])
  @@index([removedAt, createdAt])
  @@index([authorId, createdAt])
}

/** « Je veux ça remplacé aussi » — une voix par membre et par appel. */
model BoycottSupport {
  id        String   @id @default(cuid())
  callId    String
  userId    String
  createdAt DateTime @default(now())

  call BoycottCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId, createdAt])
}

/// Témoignage VIDÉO, toujours rattaché à un appel.
///
/// Une vidéo ne peut pas exister seule : elle s'accroche à un appel, donc à
/// une demande qui dit déjà, par écrit, ce qu'on voudrait à la place. C'est
/// ce qui empêche le fil vidéo de devenir un mur de colère sans issue — et
/// ce qui garde la posture d'hébergeur lisible : le propos vidéo prolonge
/// un propos écrit, signé, sourçable et déjà encadré par la charte.
///
/// Le fichier vit sur Vercel Blob (upload direct navigateur → Blob : une
/// vidéo ne passe pas par une Server Action, dont le corps est plafonné).
/// `removedAt` = retrait logique, comme partout ailleurs dans le fil ; le
/// BLOB, lui, est supprimé pour de bon — on ne garde pas la vidéo d'un
/// contenu retiré sur une URL publique devinable.
model CallVideo {
  id         String   @id @default(cuid())
  callId     String
  authorId   String
  /// URL publique du blob. Vidée au retrait, en même temps que le fichier.
  /// UNIQUE : deux lignes ne peuvent pas désigner le même fichier. Sans ça,
  /// un membre pouvait publier l'URL du témoignage d'un autre puis retirer SA
  /// ligne — la suppression du fichier détruisait la vidéo de la victime — et
  /// faire compter deux fois les mêmes octets dans la jauge. Postgres autorise
  /// autant de NULL qu'on veut dans un index unique : les lignes retirées, qui
  /// ont toutes `url = null`, ne se gênent pas entre elles.
  url        String?  @unique
  /// Vignette (première image), capturée par le navigateur à l'envoi.
  posterUrl  String?  @unique
  caption    String
  durationMs Int
  width      Int?
  height     Int?
  /// Octets réellement occupés sur le stockage (vidéo + vignette), mesurés
  /// côté serveur à la publication — jamais déclarés par le client. Null si
  /// la mesure a échoué (best-effort) ; la ligne garde sa valeur au retrait,
  /// mais la jauge ne somme que les fichiers vivants (url non nulle).
  storedBytes Int?

  removedAt     DateTime?
  removedById   String?
  removalReason String?

  createdAt DateTime @default(now())

  call   BoycottCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([removedAt, createdAt])
  @@index([callId, removedAt, createdAt])
  @@index([authorId, createdAt])
}

/// Discussion sous un appel : nuancer, corroborer, contredire, ou proposer une
/// piste de remplacement. C'est ici que la contradiction se dit — un fil où
/// l'on ne peut qu'acclamer n'est pas une place publique.
/// Retrait possible par l'auteur du commentaire, l'auteur de l'appel, ou la
/// modération (mêmes règles que les commentaires de projet).
model CallComment {
  id        String   @id @default(cuid())
  callId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  // Retrait LOGIQUE, comme pour un appel. Trois raisons de ne pas supprimer
  // la ligne : les plafonds anti-spam ne doivent pas se réinitialiser quand
  // on efface ses propres messages, un signalement doit rester traitable
  // après le retrait, et la modération a besoin de la pièce à conviction.
  // C'est le RENDU qui disparaît, pas la preuve.
  removedAt   DateTime?
  removedById String? // null + removedAt posé = retiré par son auteur

  call BoycottCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callId, removedAt, createdAt])
  @@index([userId, createdAt])
}

/** Un porteur déclare que son projet répond à l'appel : la demande trouve son remplaçant. */
model BoycottAnswer {
  id        String   @id @default(cuid())
  callId    String
  projectId String
  createdAt DateTime @default(now())
  // Le détachement garde la ligne : `@@unique([callId, projectId])` devient
  // la mémoire du fait qu'on a DÉJÀ prévenu les soutiens pour ce couple. Sans
  // ça, déclarer puis retirer en boucle rejoue la notification à volonté.
  withdrawnAt DateTime?
  withdrawnBy String? // qui a détaché : porteur, auteur de l'appel, ou modération

  call    BoycottCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([callId, projectId])
  @@index([projectId, withdrawnAt])
}

// ---------- Réputation ----------

model ReputationEvent {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Un jeton d'upload délivré à un membre. On garde la trace parce que le
/// quota quotidien compte les TÉMOIGNAGES PUBLIÉS : quelqu'un qui obtient des
/// jetons sans jamais publier gardait un quota intact et pouvait déposer sans
/// fin. Chaque jeton engage 30 Mo de stockage — c'est donc lui qu'il faut
/// compter, pas seulement ce qui en est ressorti.
/// Purgé par le cron quotidien.
model UploadTicket {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  /// Posé quand le fichier promis par ce jeton est devenu une ligne CallVideo.
  /// Un jeton consommé pèse déjà dans la jauge : le compter une seconde fois
  /// comme « en vol » bloquerait les dépôts après quelques publications
  /// parfaitement normales.
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([consumedAt, createdAt])
}
